{
  "name": "cargo-run",
  "productName": "Cargo Run",
  "version": "0.2.0",
  "private": true,
  "description": "Cargo Run — a Windows cargo hauling companion for Star Citizen",
  "author": "Cargo Run",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:desktop": "npm run build && node tests/desktop.cjs && node tests/tracking-desktop.cjs",
    "build": "npm run typecheck && electron-vite build",
    "package:win": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15",
    "lucide-react": "^1.59.0"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-vite": "^6.0.0",
    "vite": "^8.3.4",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^6.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/node": "^24.0.0",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "electron-builder": "^26.15.3",
    "vitest": "^5.0.5",
    "eslint": "^10.13.0",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.71.2",
    "globals": "^17.13.0",
    "playwright": "^1.64.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
